// Co-op mod: the Co-op frame of the pause menu (written for the mod; same look as the Co-op menu frames).
// Opened by the "Co-op" button of both pause frames (InGameMulti: a network co-op game, InGameMenu: a split screen game).
// What it shows and does goes through UI strings with the DLL (native/pausemenu.c has the list). Rows that do not apply are not
// shown: the second player and the input rows need a gamepad, "Player 2 controls" and "Swap" a split screen, "Remove player" a host
// with clients. The two groups at the bottom (kick) have a twin at the top rows for the case where no input row is there.
name           = CoopInfo
style          = styMenu

child = [
   {
      type      = text
      text      = COOP_FRAME_COOP
      posX      = 0, 100%
      posY      = 6%, 30
      textScale = 15
      textAlign = centerX centerY
      font      = font_main
   }
   {
      type        = background
      border      = true
      posY        = 60, 355

      child       = [
         {
            type      = text
            name      = ModLine
            posX      = 8%, 85%
            posY      = 38, 22
            textScale = 7
            textAlign = leftX centerY
