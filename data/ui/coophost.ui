// Co-op mod: host a co-op game (written for the mod; level list as in the game's Replay Level frame,
// settings as in its server settings). The level lines and map ids below are filled in by build_pak.py
// from the singleplayer entries of the player's gs_map_list.cls (campaign order).
name           = CoopHost
style          = styMenu
type           = PreCreateGame

child = [
   {
      type      = text
      text      = COOP_FRAME_HOST
      posX      = 0, 100%
      posY      = 6%, 30
      textScale = 15
      textAlign = centerX centerY
      font      = font_main
   }
   {
      type        = background
      border      = true
      posY        = 60, 355

      child       = [
         {
            name        = LevelList
            type        = scroll
            posX        = 0, 50%
            posY        = 15, -10

            lines       = 12
            linesX      = 0, 100%
            linesY      = 25, -25
            selectorX   = center, 90%
            selectorY   = center, 100%
            ctrlX       = center, 85%
            ctrlY       = 0 0

            line {
               type        = text
               textScale   = 8
               textAlign   = centerX centerY
            }

            child = [
               {
                  type     = button
                  texture  = arrow_up
                  name     = up
                  posX     = center, 30
                  posY     = 0, 30
                  textureMirror  = false
                  texHighlighted = true
               }
               {
                  type     = button
                  texture  = arrow_down
                  name     = down
                  posX     = center, 30
                  posY     = -30, 30
                  textureMirror  = false
                  texHighlighted = true
               }
            ]
         }
         {
            type        = text
            name        = Preview
            posX        = -275, -15
            posY        = 15, 170
            edged       = true
         }
         {
            type        = select
            name        = CoopDifficulty
            posX        = 52%, -15
            posY        = 195, 30
            text        = UI_ADVSERV_DIFFICULTY
            textAlign   = left centerY
            section     = Multiplayer
            typeVal     = String

            child = [
               {
                  type      = button
                  texture   = arrow_left
                  name      = left
                  posX      = -175, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = button
                  texture   = arrow_right
                  name      = right
                  posX      = -30, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = text
                  name      = value
                  textScale = 8
                  textAlign = centerX centerY
                  posX      = -160, -15
                  posY      = 5, 20
                  NoSoundOnFocus = true
               }
            ]
         }
         {
            type        = select
            name        = CoopMaxPlayers
            posX        = 52%, -15
            posY        = 228, 30
            text        = UI_ADVSERV_MAX_PLAYERS
            textAlign   = left centerY
            section     = Multiplayer
            typeVal     = String

            child = [
               {
                  type      = button
                  texture   = arrow_left
                  name      = left
                  posX      = -175, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = button
                  texture   = arrow_right
                  name      = right
                  posX      = -30, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = text
                  name      = value
                  textScale = 8
                  textAlign = centerX centerY
                  posX      = -160, -15
                  posY      = 5, 20
                  NoSoundOnFocus = true
               }
            ]
         }
         {
            type        = select
            name        = CoopNetwork
            posX        = 52%, -15
            posY        = 261, 30
            text        = UI_CREATE_SERVER_NETWORK
            textAlign   = left centerY
            section     = Multiplayer
            typeVal     = String

            child = [
               {
                  type      = button
                  texture   = arrow_left
                  name      = left
                  posX      = -175, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = button
                  texture   = arrow_right
                  name      = right
                  posX      = -30, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = text
