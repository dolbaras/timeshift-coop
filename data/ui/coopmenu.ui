// Co-op mod: the Co-op entry of the main menu (written for the mod; same look as the Multiplayer frame).
// The version text is filled in by build_pak.py.
name           = CoopMenu
style          = styMenu
type           = PreCreateGame

child = [
   {
      type      = text
      text      = COOP_FRAME_COOP
      posX      = 0, 100%
      posY      = 6%, 30
      textScale = 15
      textAlign = centerX centerY
      font      = font_main
   }
   {
      type        = background
      posY        = 60, 355

      child       = [
         {
            type        = box
            posX        = center, 85%
            posY        = 60,2
            texture     = bg_selection
         }
         {
            type      = text
            name      = Hint
            text      = COOP_HINT_MENU
            posX      = 8%, 85%
            posY      = 5, 50
            textScale = 8
            textAlign = leftX centerY
            textColor = 255 255 255 255
            wordwrap  = yes
         }
         {
            type        = button
            name        = Host
            posX        = center, 100%
            posY        = 130, 30
            text        = UI_BTN_LAN_SERVER
         }
         {
            type        = button
            name        = JoinLAN
            posX        = center, 100%
            posY        = 160, 30
            text        = UI_BTN_LAN_CLIENT
         }
         {
            type        = button
            name        = JoinInternet
            posX        = center, 100%
            posY        = 190, 30
            text        = UI_BTN_IP_CLIENT
         }
         {
            type        = button
            name        = JoinDirect
            posX        = center, 100%
            posY        = 220, 30
            text        = UI_BTN_DIRECT_CONNECT
         }
         {
            type        = button
            name        = Split
            posX        = center, 100%
            posY        = 250, 30
            text        = COOP_BTN_SPLIT
         }
         {
            type        = select
            name        = CoopSplitJoin
            posX        = 10%, 80%
            posY        = 285, 30
            text        = COOP_OPT_SPLITJOIN
            textAlign   = left centerY
            typeVal     = String

            child = [
               {
                  type      = button
                  texture   = arrow_left
                  name      = left
                  posX      = -175, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = button
                  texture   = arrow_right
                  name      = right
                  posX      = -30, 30
                  posY      = 0, 30
                  textureMirror  = false
                  NoSoundOnFocus = true
                  texHighlighted = true
               }
               {
                  type      = text
                  name      = value
                  textScale = 8
                  textAlign = centerX centerY
                  posX      = -160, -15
                  posY      = 5, 20
                  NoSoundOnFocus = true
               }
            ]
         }
         {
            type      = text
            name      = ModVersion
            posX      = 8%, 85%
            posY      = -30, 25
            textScale = 7
            textAlign = right centerY
         }
      ]
   }
   {
      type        = box
      border      = true
      posY        = -65, 40
      child       = [
         {
            type        = esc_button
            name        = Back
            text        = UI_BTN_BACK
            textAlign   = left centerY
            textScale   = 12
            posX        = 10, 100
            posY        = 5, 30
            XBoxShortCut = B
         }
      ]
   }
]

ssl = <<<

   override OnInit
      Element("ModVersion").SetText("COOP_MOD_VERSION,%VERSION%")
      // joining with split screen: a second player on pad 2 on this PC (native/split.c reads the UI
      // string CoopSplitJoin; the choice is kept in the profile and set again by the main menu)
      Element("CoopSplitJoin").AddItem("UI_SOFF", "0")
      Element("CoopSplitJoin").AddItem("UI_SON", "1")
      SplitJoinInit()
   end

   // (the profile key read into a string first: a missing key is null, which a comparison refuses)
   func SplitJoinInit()
      var v : string
      v := $ui.GetUserVar("CoopSplitJoin")
      if v == "1"
         Element("CoopSplitJoin").SetVal("1")
      else
         Element("CoopSplitJoin").SetVal("0")
      end
      $ui.SetStr("CoopSplitJoin", Element("CoopSplitJoin").GetVal())
   end

   // (the profile key is written only when the player changes the choice: setting the value in OnInit
   // also comes here, and a profile without the key keeps it off without writing it)
   override OnSelectSelection("CoopSplitJoin")
      var v : string
      v := $ui.GetUserVar("CoopSplitJoin")
      $ui.SetStr("CoopSplitJoin", Element("CoopSplitJoin").GetVal())
      if Element("CoopSplitJoin").GetVal() == "1" or v == "1"
         $ui.SetUserVar("CoopSplitJoin", Element("CoopSplitJoin").GetVal())
         $ui.FlushCfg()
      end
   end

   // CoopAuto (UI string) starts a step by itself; only test builds set it (lab recipe)
   override OnUpdate
      if $ui.GetStr("CoopAuto") == "host"
         $ui.SetStr("CoopAuto", "host_go")
         $ui.SwitchFrame("CoopHost")
      else if $ui.GetStr("CoopAuto") == "join"
         $ui.SetStr("CoopAuto", "join_address")
         $ui.ShowFrame("AddressInputFrame")
      end
   end

   override OnButtonPressed("Host")
      $ui.SwitchFrame("CoopHost")
   end

   override OnButtonPressed("JoinLAN")
      $ui.SwitchFrame("JoinGameLAN")
   end

   override OnButtonPressed("JoinInternet")
      $ui.SwitchFrame("JoinGame")
   end

   override OnButtonPressed("JoinDirect")
      $ui.ShowFrame("AddressInputFrame")
   end

   override OnButtonPressed("Split")
      $ui.SwitchFrame("CoopSplit")
   end

   override OnButtonPressed("Back")
      $ui.BackFrame()
   end
>>>
